# Jonli oqim uchun nginx bloklari — `api.raqamli-karyer.uz` server bloki ichiga.
# MediaMTX 127.0.0.1:8888 (HLS) va :8889 (WebRTC) da turadi; tashqariga faqat
# shu HTTPS orqali chiqadi (doc: MediaMTX portlari internetga ochilmaydi).
#
# Prodda qo'lda qo'yiladi (nginx config repoda kuzatilmaydi) — shuning uchun
# bu yerda namuna sifatida saqlanadi, 2026-08-06 da o'rnatilgan holat.

location /live/hls/ {
    proxy_pass http://127.0.0.1:8888/;
    # MUHIM: MediaMTX cookie tekshiruvida ildizga redirect qiladi
    # ("Location: /karyer_.../index.m3u8?cookieCheck=1"). Prefiks tiklanmasa
    # brauzer so'rovni backendga olib boradi va {"detail":"Not Found"} oladi —
    # pleer esa sababsiz bo'sh qoladi.
    proxy_redirect / /live/hls/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Past kechikishli HLS qismlarni oqim sifatida uzatadi.
    proxy_buffering off;
    # CORS sarlavhasini MediaMTX o'zi qo'yadi (hlsAllowOrigins) — bu yerda
    # takrorlamang: ikkita qiymat kelsa brauzer so'rovni rad etadi.
}

location /live/webrtc/ {
    proxy_pass http://127.0.0.1:8889/;
    proxy_redirect / /live/webrtc/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_buffering off;
}

# Eslatma: WebRTC media nginx orqali o'tmaydi — brauzer bilan to'g'ridan
# ICE ulanishi (8189/udp va 8189/tcp) orqali oqadi. Ular docker-compose'da
# e'lon qilingan va firewall'da ochiq bo'lishi kerak. RTSP push — 8554/tcp.
